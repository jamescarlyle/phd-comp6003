[NEAT]
fitness_criterion      = max
fitness_threshold      = 250
no_fitness_termination = False
pop_size               = 150
reset_on_extinction    = True

[DefaultGenome]
# Network structure
num_inputs              = 8
num_outputs             = 4
num_hidden              = 0
feed_forward            = True
initial_connection      = full_direct

# Activation
activation_default      = tanh
activation_mutate_rate  = 0.01
activation_options      = tanh sigmoid relu

# Aggregation
aggregation_default     = sum
aggregation_mutate_rate = 0.0
aggregation_options     = sum

# Bias
bias_init_mean          = 0.0
bias_init_stdev         = 1.0
bias_init_type          = gaussian
bias_max_value          = 30.0
bias_min_value          = -30.0
bias_mutate_power       = 0.2
bias_mutate_rate        = 0.25
bias_replace_rate       = 0.03

# Compatibility
compatibility_disjoint_coefficient = 1.5
compatibility_weight_coefficient   = 1.0

# Connection add/remove
conn_add_prob           = 0.1
conn_delete_prob        = 0.03

# Connection enabled
enabled_default              = True
enabled_mutate_rate          = 0.003
enabled_rate_to_true_add     = 0.0
enabled_rate_to_false_add    = 0.0

# Node add/remove
node_add_prob           = 0.03
node_delete_prob        = 0.01

# Response
response_init_mean      = 1.0
response_init_stdev     = 0.0
response_init_type      = gaussian
response_max_value      = 30.0
response_min_value      = -30.0
response_mutate_power   = 0.0
response_mutate_rate    = 0.0
response_replace_rate   = 0.0

# Weight
weight_init_mean        = 0.0
weight_init_stdev       = 1.0
weight_init_type        = gaussian
weight_max_value        = 30.0
weight_min_value        = -30.0
weight_mutate_power     = 0.2
weight_mutate_rate      = 0.3
weight_replace_rate     = 0.03

# Structural mutation
single_structural_mutation  = True
structural_mutation_surer   = default

[DefaultSpeciesSet]
compatibility_threshold = 2.5

[DefaultStagnation]
species_fitness_func = max
max_stagnation       = 15
species_elitism      = 2

[DefaultReproduction]
elitism            = 4
survival_threshold = 0.25
min_species_size   = 4